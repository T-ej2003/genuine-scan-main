# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS builder

WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --no-fund

COPY components.json ./
COPY eslint.config.js ./
COPY index.html ./
COPY postcss.config.js ./
COPY tailwind.config.ts ./
COPY tsconfig.app.json ./
COPY tsconfig.incremental-strict.json ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./
COPY vite.config.ts ./
COPY vitest.config.ts ./
COPY public ./public
COPY scripts ./scripts
COPY shared ./shared
COPY src ./src

ARG VITE_API_URL=/api
ARG GIT_SHA=unknown
ARG RELEASE_GIT_SHA=${GIT_SHA}
ARG VITE_APP_ENV=production
ARG VITE_SENTRY_DSN=

ENV VITE_API_URL=${VITE_API_URL}
ENV GIT_SHA=${RELEASE_GIT_SHA}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}

RUN npm run build

FROM nginx:1.29-alpine

ARG GIT_SHA=unknown
ARG RELEASE_GIT_SHA=${GIT_SHA}
LABEL org.opencontainers.image.revision=${RELEASE_GIT_SHA}

COPY nginx.ecs-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
