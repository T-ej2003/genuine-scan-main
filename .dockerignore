# Git
.git
.gitignore

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist
build
coverage
*.tsbuildinfo
artifacts
audit-artifacts

# OS/editor
.DS_Store
.vscode
.idea

# Backend/runtime artifacts not needed for frontend image context
backend/node_modules
backend/dist
backend/.connector-build
backend/.pkg-cache
backend/.env
backend/certs
backend/*.zip
backend/src.zip
backend/prisma.zip
# Backend images serve only the latest connector release payload assembled by
# backend/scripts/create-connector-runtime-assets.mjs. Keep historical release
# binaries out of the Docker context; do not remove them from the repository.
backend/local-print-agent/releases/*
!backend/local-print-agent/releases/manifest.json
!backend/local-print-agent/releases/2026.6.25
!backend/local-print-agent/releases/2026.6.25/**
backend/local-print-agent/releases/*/macos

# Local IaC/plugin/debug artifacts
infra/aws/terraform/.terraform
*.log
*.tmp
*.trace
*.har
*.webm
*.tgz
*-debug.zip
*-logs.zip
test-results
playwright-report

# Local secrets/config
.env
.env.*
!.env.example
databasefiles

# TLS certbot state is mounted at runtime; exclude from image build contexts.
# Prevents docker build context permission errors when certbot creates root-owned files.
deploy/certbot
