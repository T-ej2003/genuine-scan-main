[Setup]
AppId={{D9B7502F-CB24-4A65-B84F-A5D9390C0D8A}
AppName=MSCQR Connector__MSCQR_BUILD_SUFFIX__
AppVersion=__MSCQR_CONNECTOR_VERSION__
AppPublisher=MSCQR
DefaultDirName={localappdata}\MSCQR\local-print-agent
DefaultGroupName=MSCQR Connector
DisableProgramGroupPage=yes
DisableDirPage=yes
UsePreviousAppDir=yes
SetupMutex=MSCQRConnectorSetup
Compression=lzma
SolidCompression=yes
PrivilegesRequired=lowest
WizardStyle=modern
#ifdef MSCQR_SIGNED_RELEASE
#ifdef MSCQR_DEVELOPMENT_FIXTURE
#error Development fixtures cannot enter signed release compilation.
#endif
#if Ver != 0x06070100
#error Signed releases require Inno Setup 6.7.1.
#endif
SignTool=mscqr
SignedUninstaller=yes
#endif
OutputDir=__WINDOWS_OUTPUT_DIR__
OutputBaseFilename=MSCQR-Connector-Windows-__MSCQR_CONNECTOR_VERSION____MSCQR_BUILD_SUFFIX__-unsigned
UninstallDisplayIcon={app}\bin\mscqr-local-print-agent.exe

[Files]
Source: "__WINDOWS_STAGE_DIR__\*"; DestDir: "mscqr-payload"; Flags: dontcopy recursesubdirs
Source: "__WINDOWS_STAGE_DIR__\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion; Check: IsFreshInstallation

[Icons]
Name: "{group}\MSCQR Connector"; Filename: "{app}\Install Connector.cmd"
Name: "{group}\Uninstall MSCQR Connector"; Filename: "{app}\Uninstall Connector.cmd"

[Code]
var
  UpgradeMode, ReinstallMode, UpgradePrepared, SetupCommitted, InitializationFailed, PrintingPaused, RecoveryCompleted,
    UninstallPrepared, UninstallCommitted: Boolean;
  LastUpgradeCode: Integer;

function JsonEscape(const Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

procedure WriteLifecycleFailure(const Operation, Stage, ErrorId, Message: String;
  PreviousUsable, Manual: Boolean);
var Root, LogPath, Body, UsableText, ManualText, Stamp: String;
begin
  Root := ExpandConstant('{localappdata}\MSCQR\lifecycle');
  CreateDir(ExpandConstant('{localappdata}\MSCQR'));
  CreateDir(Root);
  LogPath := Root + '\installer.log';
  Stamp := GetDateTimeString('yyyy-mm-dd hh:nn:ss', '-', ':');
  if PreviousUsable then UsableText := 'true' else UsableText := 'false';
  if Manual then ManualText := 'true' else ManualText := 'false';
  Body := '{"operation":"' + JsonEscape(Operation) + '","stage":"' + JsonEscape(Stage) +
    '","errorId":"' + JsonEscape(ErrorId) + '","message":"' + JsonEscape(Message) +
    '","logPath":"' + JsonEscape(LogPath) + '","previousInstallationUsable":' +
    UsableText + ',"manualInterventionRequired":' + ManualText + ',"timestamp":"' +
    Stamp + '","outcome":"failure"}';
  if not SaveStringToFile(Root + '\installer-result.json', Body, False) or
     not SaveStringToFile(LogPath, Stamp + ' ' + Operation + ' ' + Stage + ' ' + ErrorId + #13#10, True) then
    Log('Lifecycle failure result could not be persisted at ' + Root);
end;

function GetCustomSetupExitCode: Integer;
begin
  if InitializationFailed then Result := 20
  else Result := 0;
end;

function InitializeUninstall(): Boolean;
begin
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Code: Integer; Params, ScriptPath, CompletionCopy: String;
begin
  if CurUninstallStep = usUninstall then begin
    ScriptPath := ExpandConstant('{app}\uninstall-startup-task.ps1');
    CompletionCopy := ExpandConstant('{tmp}\mscqr-uninstall-complete.ps1');
    if not CopyFile(ScriptPath, CompletionCopy, False) then begin
      WriteLifecycleFailure('uninstall', 'preflight-copy', 'UNINSTALL_CHECK_COPY_FAILED',
        'Removal could not preserve the completion check. No application files were removed.', True, True);
      RaiseException('Connector removal could not preserve its completion check. No application files were removed.');
    end;
    Params := '-NoProfile -NonInteractive -ExecutionPolicy AllSigned -File "' + ScriptPath + '" -Operation Preflight';
    Code := -1;
    if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params,
      ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then begin
      WriteLifecycleFailure('uninstall', 'preflight', 'UNINSTALL_PREFLIGHT_FAILED',
        'Removal stopped before Inno deleted files. The connector may remain fenced; review the local uninstall result.', False, True);
      RaiseException('Connector removal stopped before Inno deleted files. Review %LOCALAPPDATA%\MSCQR\lifecycle\uninstall-result.json and uninstall.log.');
    end;
    UninstallPrepared := True;
    exit;
  end;
  if CurUninstallStep <> usPostUninstall then exit;
  Params := '-NoProfile -NonInteractive -ExecutionPolicy AllSigned -File "' +
    ExpandConstant('{tmp}\mscqr-uninstall-complete.ps1') + '" -Operation Complete';
  Code := -1;
  if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params,
    ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then begin
    WriteLifecycleFailure('uninstall', 'complete', 'UNINSTALL_COMPLETION_FAILED',
      'Removal could not verify preserved identity, configuration and journal.', False, True);
    RaiseException('Connector removal could not verify preserved identity, configuration and journal. Review %LOCALAPPDATA%\MSCQR\lifecycle\uninstall-result.json.');
  end;
  UninstallCommitted := True;
end;

procedure DeinitializeUninstall;
begin
  if UninstallPrepared and not UninstallCommitted then
    WriteLifecycleFailure('uninstall', 'removal', 'UNINSTALL_INCOMPLETE',
      'Removal stopped after preflight. Dispatch remains fenced; inspect the installation before retrying.', False, True);
end;

function IsFreshInstallation: Boolean;
begin
  Result := not UpgradeMode;
end;

function PowerShellLiteral(const Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, Chr(39), Chr(39) + Chr(39), True);
  Result := Chr(39) + Result + Chr(39);
end;

function VerifyUpgradePayloadSignatures: Boolean;
var Code: Integer; Params, Command, Payload: String;
begin
  Payload := ExpandConstant('{tmp}\mscqr-payload');
  Command := '$runtime = Get-AuthenticodeSignature -LiteralPath ' +
    PowerShellLiteral(Payload + '\bin\mscqr-local-print-agent.exe') +
    '; if ($runtime.Status -ne ''Valid'' -or -not $runtime.TimeStamperCertificate -or ' +
    '$runtime.SignerCertificate.GetNameInfo([Security.Cryptography.X509Certificates.X509NameType]::SimpleName, $false) -cne ''L&D Health Ltd'') { exit 1 }; ' +
    '$files = @(' + PowerShellLiteral(Payload + '\connector-upgrade-transaction.ps1') + ', ' +
    PowerShellLiteral(Payload + '\connector-upgrade-staging.ps1') + ', ' +
    PowerShellLiteral(Payload + '\connector-upgrade-backup.ps1') + ', ' +
    PowerShellLiteral(Payload + '\connector-upgrade-state.ps1') +
    '); foreach ($file in $files) { $signature = Get-AuthenticodeSignature -LiteralPath $file; ' +
    'if ($signature.Status -ne ''Valid'' -or -not $signature.TimeStamperCertificate -or ' +
    '$signature.SignerCertificate.Thumbprint -cne $runtime.SignerCertificate.Thumbprint) { exit 1 } }';
  Params := '-NoProfile -NonInteractive -Command "' + Command + '"';
  Code := -1;
  Result := Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params,
    ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code);
  Result := Result and (Code = 0);
end;

function RunUpgrade(const Operation: String): Boolean;
var Code: Integer; Params: String;
begin
  Result := VerifyUpgradePayloadSignatures;
  if not Result then begin
    WriteLifecycleFailure('upgrade', 'signature', 'CONNECTOR_PAYLOAD_SIGNATURE_INVALID',
      'Signed connector payload verification failed. No files were replaced.', True, True);
    exit;
  end;
  Params := '-NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File "' + ExpandConstant('{tmp}\mscqr-payload\connector-upgrade-transaction.ps1') +
    '" -Operation ' + Operation + ' -PayloadDirectory "' + ExpandConstant('{tmp}\mscqr-payload') +
    '" -InstallerFile "' + ExpandConstant('{srcexe}') + '" -LiveDirectory "' +
    ExpandConstant('{app}') + '" -AuthorizationFile "' +
    ExpandConstant('{localappdata}\MSCQR\connector-upgrade\authorization.json') + '" -TargetVersion "__MSCQR_CONNECTOR_VERSION__"';
  Code := -1;
  Result := Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params,
    ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code);
  LastUpgradeCode := Code;
  if (Operation = 'Commit') and (Code = 10) then PrintingPaused := True;
  if (Operation = 'Recover') and (Code = 11) then RecoveryCompleted := True;
  Result := Result and ((Code = 0) or ((Operation = 'Commit') and (Code = 10)) or
    ((Operation = 'Recover') and (Code = 11)) or
    ((Operation = 'Classify') and (Code >= 30) and (Code <= 32)));
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var HasInstallEvidence, HasRetainedEvidence: Boolean;
begin
  Result := '';
#ifdef MSCQR_DEVELOPMENT_FIXTURE
  Result := 'DEVELOPMENT FIXTURE: installation and production upgrades are disabled. Use the governed signed candidate workflow for certification.';
  exit;
#endif
  if ExpandConstant('{%USERPROFILE}') = '' then begin
    Result := 'Windows user profile could not be resolved. Installation was cancelled.';
    WriteLifecycleFailure('install', 'profile', 'CONNECTOR_PROFILE_UNAVAILABLE', Result, False, True);
    exit;
  end;
  HasInstallEvidence := DirExists(ExpandConstant('{app}')) or
    FileExists(ExpandConstant('{app}\bin\mscqr-local-print-agent.exe')) or
    FileExists(ExpandConstant('{app}\unins000.exe')) or
    FileExists(ExpandConstant('{app}\unins000.dat')) or
    FileExists(ExpandConstant('{userstartup}\MSCQR Connector.vbs')) or
    RegKeyExists(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{D9B7502F-CB24-4A65-B84F-A5D9390C0D8A}_is1');
  HasRetainedEvidence := FileExists(ExpandConstant('{%USERPROFILE}\.mscqr\local-print-agent-state.json')) or
    FileExists(ExpandConstant('{%USERPROFILE}\.authenticqr\local-print-agent-state.json')) or
    FileExists(ExpandConstant('{app}\agent.env')) or
    DirExists(ExpandConstant('{%USERPROFILE}\.mscqr\dispatch-journal'));
  if HasInstallEvidence or HasRetainedEvidence then begin
    ExtractTemporaryFiles('mscqr-payload\*');
    if not RunUpgrade('Classify') then begin
      Result := 'Connector installation state is incomplete or invalid. No files were replaced. Review the local lifecycle log and preserve the identity and dispatch journal.';
      WriteLifecycleFailure('install', 'classify', 'INCONSISTENT_INSTALLATION', Result, False, True);
      exit;
    end;
    UpgradeMode := LastUpgradeCode = 32;
    ReinstallMode := LastUpgradeCode = 31;
  end;
  if ReinstallMode then exit;
  if UpgradeMode then begin
    if ExpandConstant('{param:MSCQRRECOVER|}') = '1' then begin
      if RunUpgrade('Recover') then
        Result := 'Previous installation restoration was verified. This upgrade remains cancelled and dispatch remains fenced. Review the journal before another attempt.'
      else begin
        Result := 'Interrupted upgrade restoration could not be verified. Keep dispatch fenced and inspect the durable journal.';
        WriteLifecycleFailure('upgrade', 'recover', 'CONNECTOR_UPGRADE_RECOVERY_FAILED', Result, False, True);
      end;
      exit;
    end;
    if FileExists(ExpandConstant('{localappdata}\MSCQR\connector-upgrade\transaction.json')) then begin
      if not RunUpgrade('Recover') then begin
        Result := 'The previous connector upgrade remains safely paused. Retry when backend verification is available.';
        WriteLifecycleFailure('upgrade', 'recover', 'CONNECTOR_UPGRADE_RECOVERY_PAUSED', Result, False, True);
        exit;
      end;
      if RecoveryCompleted then begin
        Result := 'The previous connector upgrade is verified and printing restrictions were safely restored. No further installation is needed.';
        exit;
      end;
    end;
    if not RunUpgrade('Acquire') then
      Result := 'Upgrade authorization could not be verified. The existing installation is unchanged.'
    else if not RunUpgrade('Prepare') then
      Result := 'Upgrade preflight, backend authorization, staging or backup failed. The existing runtime has not been replaced.'
    else UpgradePrepared := True;
    if Result <> '' then
      WriteLifecycleFailure('upgrade', 'prepare', 'CONNECTOR_UPGRADE_PREFLIGHT_FAILED', Result, True, True);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
  Parameters: String;
begin
  if CurStep = ssPostInstall then begin
    if UpgradeMode then begin
      if not RunUpgrade('Activate') then begin
        InitializationFailed := True;
        WriteLifecycleFailure('upgrade', 'activate', 'CONNECTOR_UPGRADE_ACTIVATION_FAILED',
          'Connector upgrade activation failed; dispatch remains fenced.', False, True);
        Log('Connector upgrade activation failed. Review the durable upgrade journal; dispatch remains fenced.');
        if not WizardSilent then
          MsgBox('Connector upgrade failed. Review the durable upgrade journal; dispatch remains fenced.', mbError, MB_OK);
      end;
      exit;
    end;
    Parameters := '/c ""' + ExpandConstant('{app}\Install Connector.cmd') + '"';
    if WizardSilent then Parameters := Parameters + ' /MSCQRSILENT';
    if ReinstallMode then Parameters := Parameters + ' /MSCQRREINSTALL';
    Parameters := Parameters + '"';
    if not Exec(ExpandConstant('{cmd}'), Parameters, ExpandConstant('{app}'), SW_HIDE,
      ewWaitUntilTerminated, ResultCode) then begin
      InitializationFailed := True;
      WriteLifecycleFailure('install', 'initialization', 'CONNECTOR_INITIALIZATION_START_FAILED',
        'Connector initialization could not be started.', False, True);
      Log('Connector initialization could not be started.');
      if not WizardSilent then
        MsgBox('Connector initialization could not be started. Review the setup log.', mbError, MB_OK);
      exit;
    end;
    { Exit 10 is emitted only after startup registration, version/protocol and
      exactly-one-process verification. It does not certify printer readiness.
      This fresh-install contract never applies to RunUpgrade: every upgrade
      phase still requires exit 0 and independent transaction verification. }
    if ResultCode = 10 then begin
      Log('Connector installed and runtime verified; printer setup needs attention. Open MSCQR Printer Setup and check the selected printer.');
      if not WizardSilent then
        MsgBox('MSCQR Connector is installed and running. Printer setup needs attention: open MSCQR Printer Setup, select a printer and check that Windows reports it online. Printing readiness has not been verified. See the connector setup log and install-result.json.', mbInformation, MB_OK);
    end else if ResultCode <> 0 then begin
      InitializationFailed := True;
      WriteLifecycleFailure('install', 'verification', 'CONNECTOR_INITIALIZATION_FAILED',
        'Connector initialization or verification failed. Review the retained setup result.', False, True);
      Log('Connector initialization or verification failed (exit ' + IntToStr(ResultCode) + ').');
      if not WizardSilent then
        MsgBox('Connector initialization or verification failed. Review the connector setup log.', mbError, MB_OK);
      exit;
    end;
  end;
  if CurStep = ssDone then begin
    if InitializationFailed then exit;
    if UpgradeMode then begin
      if not RunUpgrade('Commit') then begin
        InitializationFailed := True;
        WriteLifecycleFailure('upgrade', 'commit', 'CONNECTOR_UPGRADE_COMMIT_FAILED',
          'Connector upgrade commit verification failed; dispatch remains fenced.', False, True);
        Log('Connector upgrade commit verification failed; dispatch remains fenced.');
        if not WizardSilent then
          MsgBox('Connector upgrade commit verification failed; dispatch remains fenced.', mbError, MB_OK);
        exit;
      end;
    end;
    SetupCommitted := True;
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpFinished) and UpgradeMode and SetupCommitted then begin
    WizardForm.FinishedHeadingLabel.Caption := 'MSCQR Connector updated';
    if PrintingPaused then
      WizardForm.FinishedLabel.Caption := 'The connector and printer settings were preserved. Printing remains paused because backend safety verification did not complete. Uncertain print attempts will not be replayed.'
    else
      WizardForm.FinishedLabel.Caption := 'The connector and printer settings were preserved. Eligible printing can resume. Uncertain print attempts remain protected.';
  end;
  if (CurPageID = wpFinished) and InitializationFailed then begin
    WizardForm.FinishedHeadingLabel.Caption := 'MSCQR Connector setup failed';
    if UpgradeMode then
      WizardForm.FinishedLabel.Caption := 'The connector upgrade did not complete. Close Setup to run recovery. Keep dispatch fenced and inspect the durable upgrade journal before retrying.'
    else
      WizardForm.FinishedLabel.Caption := 'The connector installation did not initialize successfully. Review the setup log before retrying.';
  end;
end;

procedure DeinitializeSetup;
begin
  if UpgradePrepared and not SetupCommitted then
    if not RunUpgrade('Recover') then
    begin
      WriteLifecycleFailure('upgrade', 'recover', 'CONNECTOR_UPGRADE_RECOVERY_FAILED',
        'Upgrade recovery is not verified. Keep dispatch fenced and inspect the transaction journal.', False, True);
      Log('Upgrade recovery is NOT verified. Keep dispatch fenced and inspect the transaction journal.');
    end;
end;
