{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSCQR Secret Rotation Evidence",
  "type": "object",
  "required": [
    "evidenceVersion",
    "rotationId",
    "recordedAt",
    "sourceSha",
    "approvedBy",
    "approverRole",
    "reason",
    "ticket",
    "environment",
    "cleanupWindowComplete",
    "cleanupCompletedAt",
    "cleanupVerifiedBy",
    "overlapReadyAt",
    "verifiedAt",
    "cleanupEligibleAt",
    "retirementTimestamp",
    "cleanupDeploymentSha",
    "cleanupDeploymentObservedAt",
    "proofs",
    "linkedDeployShas",
    "verificationRefs",
    "families"
  ],
  "properties": {
    "evidenceVersion": { "const": 2 },
    "rotationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedBy": {
      "type": "string",
      "minLength": 2
    },
    "approverRole": {
      "type": "string",
      "minLength": 2
    },
    "reason": {
      "type": "string",
      "minLength": 6
    },
    "ticket": {
      "type": "string",
      "minLength": 3
    },
    "environment": {
      "type": "string",
      "enum": ["staging", "production", "shared"]
    },
    "cleanupWindowComplete": {
      "type": "boolean"
    },
    "cleanupCompletedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cleanupVerifiedBy": {
      "type": "string",
      "minLength": 2
    },
    "overlapReadyAt": { "type": "string", "format": "date-time" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "cleanupEligibleAt": { "type": "string", "format": "date-time" },
    "retirementTimestamp": { "type": "string", "format": "date-time" },
    "cleanupDeploymentSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "cleanupDeploymentObservedAt": { "type": "string", "format": "date-time" },
    "proofs": {
      "type": "object",
      "required": [
        "previousJwtSlotRetired", "previousQrPublicSlotRetired", "jwtPendingRetired", "qrPrivatePendingRetired", "qrPublicPendingRetired",
        "cleanupDeploymentAfterRetirement", "cleanupRuntimeVerified", "jwtPreviousRuntimeRejected", "qrPreviousRuntimeRejected",
        "jwtCurrentRuntimeVerify", "qrCurrentRuntimeVerify", "qrUnknownKeyRejected", "serviceHealthy"
      ],
      "properties": {
        "previousJwtSlotRetired": { "const": true },
        "previousQrPublicSlotRetired": { "const": true },
        "jwtPendingRetired": { "const": true },
        "qrPrivatePendingRetired": { "const": true },
        "qrPublicPendingRetired": { "const": true },
        "cleanupDeploymentAfterRetirement": { "const": true },
        "cleanupRuntimeVerified": { "const": true },
        "jwtPreviousRuntimeRejected": { "const": true },
        "qrPreviousRuntimeRejected": { "const": true },
        "jwtCurrentRuntimeVerify": { "const": true },
        "qrCurrentRuntimeVerify": { "const": true },
        "qrUnknownKeyRejected": { "const": true },
        "serviceHealthy": { "const": true }
      },
      "additionalProperties": false
    },
    "linkedDeployShas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "verificationRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8, "not": { "pattern": "^deploy-log://" } }
    },
    "cleanupEvidenceRef": { "type": "string", "minLength": 8, "not": { "pattern": "^deploy-log://" } },
    "families": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "rotatedAt", "operator", "method"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "rotatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "operator": {
            "type": "string",
            "minLength": 2
          },
          "method": {
            "type": "string",
            "enum": ["dual-slot", "single-slot-emergency"]
          },
          "currentVersionId": { "type": "string", "minLength": 7 },
          "previousVersionId": { "type": "string", "minLength": 7 },
          "currentKeyVersion": { "type": "string", "minLength": 1 },
          "previousKeyVersion": { "type": "string", "minLength": 1 },
          "verificationRef": { "type": "string", "minLength": 8, "not": { "pattern": "^deploy-log://" } },
          "evidenceRef": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
