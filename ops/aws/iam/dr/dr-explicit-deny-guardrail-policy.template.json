{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDestructiveDRActions",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance",
        "rds:DeleteDBCluster",
        "rds:FailoverDBCluster",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": "*"
    }
  ]
}
