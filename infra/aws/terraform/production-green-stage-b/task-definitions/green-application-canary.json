{
  "family": "mscqr-production-full-rls-green-application-canary",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::368992683803:role/mscqr-production-rls-green-canary-execution",
  "taskRoleArn": "arn:aws:iam::368992683803:role/mscqr-production-rls-green-canary-task",
  "volumes": [{ "name": "canary-tmp" }],
  "containerDefinitions": [{
    "name": "production-green-canary",
    "image": "{{CANARY_IMAGE}}",
    "essential": true,
    "entryPoint": ["node", "scripts/production-green-application-canary.mjs"],
    "readonlyRootFilesystem": true,
    "mountPoints": [{ "sourceVolume": "canary-tmp", "containerPath": "/tmp", "readOnly": false }],
    "privileged": false,
    "interactive": false,
    "pseudoTerminal": false,
    "environment": [
      { "name": "RELEASE_GIT_SHA", "value": "{{RELEASE_SHA}}" },
      { "name": "MSCQR_FULL_RLS_SOURCE_CONTRACT_SHA256", "value": "{{SOURCE_CONTRACT_SHA256}}" },
      { "name": "MSCQR_FULL_RLS_MIGRATION_SET_DIGEST", "value": "{{MIGRATION_SET_DIGEST}}" },
      { "name": "COOKIE_SECURE", "value": "true" },
      { "name": "RUN_BACKGROUND_WORKERS", "value": "false" },
      { "name": "OBJECT_STORAGE_BUCKET", "value": "mscqr-prod-euw2-artifacts-368992683803-eu-west-2-an" },
      { "name": "OBJECT_STORAGE_REGION", "value": "eu-west-2" }
    ],
    "secrets": [
      { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/app-XNeSfh" },
      { "name": "PREAUTH_DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/preauth-xW2U7k" },
      { "name": "AUTHENTICATED_APP_DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/app-XNeSfh" },
      { "name": "MSCQR_C03_PREAUTH_DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/preauth-xW2U7k" },
      { "name": "AUTH_MFA_ENCRYPTION_KEY", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/auth-mfa-encryption-key-9IgHgy" },
      { "name": "CUSTOMER_VERIFY_OTP_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/customer-verify-otp-secret-UxAGIY" },
      { "name": "CUSTOMER_VERIFY_TOKEN_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/customer-verify-token-secret-2d2D4b" },
      { "name": "INCIDENT_HASH_SALT_CURRENT", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/incident-hash-salt-current-AVDP4T" },
      { "name": "IP_HASH_SALT_CURRENT", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/ip-hash-salt-current-dRoH6B" },
      { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/jwt-wBQNqk" },
      { "name": "PRINTER_SSE_SIGN_SECRET_CURRENT", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/printer-sse-sign-secret-current-CC0JGW" },
      { "name": "QR_SIGN_PRIVATE_KEY", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/qr_sign_private_key-BcQFPO" },
