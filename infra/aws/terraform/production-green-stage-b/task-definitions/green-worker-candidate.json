{
  "family": "mscqr-production-rls-green-worker-candidate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::368992683803:role/mscqr-production-rls-green-worker-execution",
  "taskRoleArn": "arn:aws:iam::368992683803:role/mscqr-production-rls-green-worker-task",
  "containerDefinitions": [{
    "name": "worker", "image": "{{WORKER_IMAGE}}", "essential": true,
    "entryPoint": ["node", "dist/worker.js"], "readonlyRootFilesystem": true,
    "privileged": false, "interactive": false, "pseudoTerminal": false,
    "environment": [{ "name": "RELEASE_GIT_SHA", "value": "{{RELEASE_SHA}}" }, { "name": "OBJECT_STORAGE_BUCKET", "value": "mscqr-prod-euw2-artifacts-368992683803-eu-west-2-an" }, { "name": "OBJECT_STORAGE_REGION", "value": "eu-west-2" }, {"name": "SMTP_HOST", "value": "mail.privateemail.com"}, {"name": "SMTP_PORT", "value": "587"}, {"name": "SMTP_SECURE", "value": "false"}, {"name": "SMTP_REQUIRE_TLS", "value": "true"}, {"name": "SMTP_USER", "value": "administration@mscqr.com"}, {"name": "SMTP_FROM", "value": "administration@mscqr.com"}],
    "secrets": [{ "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/worker-9rba4z" }, { "name": "MSCQR_C03_WORKER_DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/production/rls-green/phase2/database-url/worker-9rba4z" }, { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/jwt-wBQNqk" }, { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/redis-i6MoFs:REDIS_URL::" }, {"name": "SMTP_PASS", "valueFrom": "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/prod/smtp-pass-arDHq6"}],
    "logConfiguration": { "logDriver": "awslogs", "options": { "awslogs-region": "eu-west-2", "awslogs-group": "{{WORKER_LOG_GROUP}}", "awslogs-stream-prefix": "stage-b" } }
  }]
}
