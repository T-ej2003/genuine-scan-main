{
  "schemaVersion": 1,
  "purpose": "Stage B broker deployment contract; not an apply manifest",
  "function": "mscqr-production-rls-approval-broker",
  "requiredAlias": "reviewed",
  "runtime": "nodejs24.x",
  "handler": "index.handler",
  "taskStartAuthority": "broker-only",
  "taskOverridesAllowed": false,
  "replayStore": { "required": true, "conditionalWrite": "attribute_not_exists(approvalMode)", "retention": "approval expiry" },
  "receiptStore": { "required": true, "writeOnce": true, "prefix": "rls-broker-receipts/" },
  "resourcePolicy": "invocation-policy.json",
  "forbiddenActions": ["ecs:UpdateService", "ecs:RegisterTaskDefinition", "elasticloadbalancing:*", "route53:*", "rds:*", "secretsmanager:GetSecretValue:runtime", "sql"],
  "stageAResourcesMutable": false,
  "frontendTaskDefinition": "mscqr-frontend:20"
}
