{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "RegisterCanonicalFrontendDefinition", "Effect": "Allow", "Action": "ecs:RegisterTaskDefinition", "Resource": "*", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" } } },
    { "Sid": "ReadTaskDefinitions", "Effect": "Allow", "Action": "ecs:DescribeTaskDefinition", "Resource": "*", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" } } },
    { "Sid": "ListExactFrontendRuntime", "Effect": "Allow", "Action": "ecs:ListTasks", "Resource": "*", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" }, "ArnEquals": { "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main" } } },
    { "Sid": "ReadExactFrontendRuntime", "Effect": "Allow", "Action": "ecs:DescribeTasks", "Resource": "arn:aws:ecs:eu-west-2:368992683803:task/mscqr-prod-euw2-main/*", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" }, "ArnEquals": { "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main" } } },
    { "Sid": "ReadAndActivateExactFrontendService", "Effect": "Allow", "Action": ["ecs:DescribeServices", "ecs:UpdateService"], "Resource": "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-prod-euw2-main/mscqr-frontend-servi-euw2", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" }, "ArnEquals": { "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main" }, "ArnLikeIfExists": { "ecs:task-definition": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-frontend:*" } } },
    { "Sid": "PassExactFrontendRoles", "Effect": "Allow", "Action": "iam:PassRole", "Resource": ["arn:aws:iam::368992683803:role/mscqr-ecs-execution-role", "arn:aws:iam::368992683803:role/mscqr-ecs-task-role"], "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } } },
    { "Sid": "ReadExactWebDigest", "Effect": "Allow", "Action": "ecr:DescribeImages", "Resource": "arn:aws:ecr:eu-west-2:368992683803:repository/mscqr-web", "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-2" } } }
  ]
}
