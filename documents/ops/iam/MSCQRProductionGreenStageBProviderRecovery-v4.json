{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TagExactStageBLogs",
      "Effect": "Allow",
      "Action": "logs:TagResource",
      "Resource": [
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-backend:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-canary:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-worker:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-read-only-canary:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Component"
          ]
        }
      }
    },
    {
      "Sid": "CreateExactStageBLogs",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": [
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-backend:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-canary:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-worker:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-read-only-canary:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "SetExactStageBLogRetention",
      "Effect": "Allow",
      "Action": "logs:PutRetentionPolicy",
      "Resource": [
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-backend:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-canary:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-worker:*",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-read-only-canary:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ListExactStageBLogTagsReadOnly",
      "Effect": "Allow",
      "Action": "logs:ListTagsForResource",
      "Resource": [
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-backend",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-canary",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-worker",
        "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-production/rls-green-read-only-canary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ReadExactStageBReadOnlyCanaryRoles",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-task"
      ]
    },
    {
      "Sid": "ListExactStageBReadOnlyCanaryRolePolicies",
      "Effect": "Allow",
      "Action": "iam:ListRolePolicies",
      "Resource": [
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-task"
      ]
    },
    {
      "Sid": "ListAttachedExactStageBReadOnlyCanaryRolePolicies",
      "Effect": "Allow",
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": [
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-task"
      ]
    },
    {
      "Sid": "ReadExactStageBReadOnlyCanaryExecutionRolePolicy",
      "Effect": "Allow",
      "Action": "iam:GetRolePolicy",
      "Resource": "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-read-only-canary-execution"
    },
    {
      "Sid": "TagExactReplayTable",
      "Effect": "Allow",
      "Action": "dynamodb:TagResource",
      "Resource": "arn:aws:dynamodb:eu-west-2:368992683803:table/mscqr-production-rls-stage-b-replay",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Component"
          ]
        }
      }
    },
    {
      "Sid": "TagExactStageBTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": [
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-rls-green-backend-candidate:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-rls-green-worker-candidate:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-application-canary:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-admin-bootstrap:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-admin-ownership:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-capability-preflight:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-role-provision:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-role-verify:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-rollback:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-runtime-policy:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-verification:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-read-only-canary:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Component"
          ]
        }
      }
    }
  ]
}
