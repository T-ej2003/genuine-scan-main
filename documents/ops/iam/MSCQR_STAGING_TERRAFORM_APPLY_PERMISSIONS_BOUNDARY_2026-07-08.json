{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowMaximumPermissionsWithinBoundary",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "DenyOutsideApprovedStagingRegion",
      "Effect": "Deny",
      "NotAction": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:Get*",
        "iam:DetachRolePolicy",
        "iam:List*",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "DenyProductionTaggedResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": [
            "prod",
            "production"
          ]
        }
      }
    },
    {
      "Sid": "DenyPermissionsBoundaryTampering",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIamRoleManagementOutsideTerraformManagedStagingEcsRoles",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "NotResource": [
        "arn:aws:iam::368992683803:role/mscqr-staging-database-role-admin-task",
        "arn:aws:iam::368992683803:role/mscqr-staging-database-role-cutover",
        "arn:aws:iam::368992683803:role/mscqr-staging-database-role-executor-broker-role",
        "arn:aws:iam::368992683803:role/mscqr-staging-ecs-execution-role",
        "arn:aws:iam::368992683803:role/mscqr-staging-ecs-task-role"
      ]
    },
    {
      "Sid": "DenyUnreviewedManagedPolicyAttachments",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::368992683803:role/mscqr-staging-ecs-execution-role",
      "Condition": {
        "StringNotEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        }
      }
    },
    {
      "Sid": "DenyManagedPolicyAttachmentsOnStagingDatabaseRoleCutover",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::368992683803:role/mscqr-staging-database-role-cutover"
    },
    {
      "Sid": "DenyManagedPolicyAttachmentsOnStagingDatabaseRoleExecutorBrokerRole",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::368992683803:role/mscqr-staging-database-role-executor-broker-role"
    },
    {
      "Sid": "DenyManagedPolicyAttachmentsOnStagingDatabaseRoleAdminTaskRole",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::368992683803:role/mscqr-staging-database-role-admin-task"
    },
    {
      "Sid": "DenyManagedPolicyAttachmentsOnStagingTaskRole",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::368992683803:role/mscqr-staging-ecs-task-role"
    }
  ]
}
