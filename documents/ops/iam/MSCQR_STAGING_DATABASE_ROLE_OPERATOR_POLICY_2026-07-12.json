{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunReviewedDisposableDatabaseRoleTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-staging-database-role-admin:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-staging-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeReviewedStagingBackendService",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-staging-euw2-main/mscqr-staging-backend-service-euw2"
    },
    {
      "Sid": "DescribeReviewedDisposableDatabaseRoleTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task/mscqr-staging-euw2-main/*"
    },
    {
      "Sid": "DescribeReviewedStagingTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-staging-*"
    },
    {
      "Sid": "ListReviewedStagingServices",
      "Effect": "Allow",
      "Action": "ecs:ListServices",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-staging-euw2-main"
    },
    {
      "Sid": "ListReviewedStagingTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:ListTaskDefinitions",
      "Resource": "*"
    },
    {
      "Sid": "ListReviewedStagingEventBridgeRules",
      "Effect": "Allow",
      "Action": "events:ListRules",
      "Resource": "*"
    },
    {
      "Sid": "ListReviewedStagingEventBridgeTargets",
      "Effect": "Allow",
      "Action": "events:ListTargetsByRule",
      "Resource": "arn:aws:events:eu-west-2:368992683803:rule/mscqr-staging*"
    },
    {
      "Sid": "DescribeReviewedStagingDatabaseRoleSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": [
        "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/staging/database-url/app-*",
        "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/staging/database-url/migrator-*",
        "arn:aws:secretsmanager:eu-west-2:368992683803:secret:mscqr/staging/database-url/rls-read-*"
      ]
    },
    {
      "Sid": "PassOnlyReviewedDatabaseRoleTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::368992683803:role/mscqr-staging-database-role-admin-task",
        "arn:aws:iam::368992683803:role/mscqr-staging-ecs-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
