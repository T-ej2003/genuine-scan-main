{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOnlyReviewedDatabaseRoleExecutorBroker",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-west-2:368992683803:function:mscqr-staging-database-role-executor-broker:reviewed"
    },
    {
      "Sid": "InspectOnlyReviewedDatabaseRoleExecutorBroker",
      "Effect": "Allow",
      "Action": "lambda:GetFunctionConfiguration",
      "Resource": "arn:aws:lambda:eu-west-2:368992683803:function:mscqr-staging-database-role-executor-broker:reviewed"
    },
    {
      "Sid": "DiscoverOnlyReviewedStagingDatabaseMetadata",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "DescribeReviewedStagingBackendService",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-staging-euw2-main/mscqr-staging-backend-service-euw2"
    },
    {
      "Sid": "DescribeReviewedDisposableDatabaseRoleTasks",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task/mscqr-staging-euw2-main/*"
    },
    {
      "Sid": "DescribeReviewedStagingTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyReviewedDatabaseRoleTaskLogs",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:eu-west-2:368992683803:log-group:/ecs/mscqr-staging-backend:log-stream:database-role-admin/db-admin/*"
    },
    {
      "Sid": "ListReviewedStagingServices",
      "Effect": "Allow",
      "Action": "ecs:ListServices",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-staging-euw2-main"
        }
      }
    },
    {
      "Sid": "ListReviewedStagingTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:ListTaskDefinitions",
      "Resource": "*"
    },
    {
      "Sid": "ListReviewedStagingEventBridgeRules",
      "Effect": "Allow",
      "Action": "events:ListRules",
      "Resource": "*"
    },
    {
      "Sid": "ListReviewedStagingEventBridgeTargets",
      "Effect": "Allow",
      "Action": "events:ListTargetsByRule",
      "Resource": "arn:aws:events:eu-west-2:368992683803:rule/mscqr-staging*"
    }
  ]
}
