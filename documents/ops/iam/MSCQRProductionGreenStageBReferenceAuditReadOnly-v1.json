{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStageALivePrerequisites",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ecs:DescribeClusters",
        "rds:DescribeDBInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ListAttachedRolePoliciesReadOnly",
      "Effect": "Allow",
      "Action": "iam:ListAttachedRolePolicies",
      "Resource": "*"
    },
    {
      "Sid": "ReadNormalActivationPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "arn:aws:iam::368992683803:policy/MSCQRProductionGreenStageBFinalApplyWrite"
    },
    {
      "Sid": "ListStageBServicesReadOnly",
      "Effect": "Allow",
      "Action": "ecs:ListServices",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeStageBServicesReadOnly",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-prod-euw2-main/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "ListExactBackendServiceDeployments",
      "Effect": "Allow",
      "Action": "ecs:ListServiceDeployments",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-prod-euw2-main/mscqr-backend-servi-euw2",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeExactBackendServiceDeployments",
      "Effect": "Allow",
      "Action": "ecs:DescribeServiceDeployments",
      "Resource": [
        "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-prod-euw2-main/mscqr-backend-servi-euw2",
        "arn:aws:ecs:eu-west-2:368992683803:service-deployment/mscqr-prod-euw2-main/mscqr-backend-servi-euw2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeExactBackendServiceRevisions",
      "Effect": "Allow",
      "Action": "ecs:DescribeServiceRevisions",
      "Resource": [
        "arn:aws:ecs:eu-west-2:368992683803:service/mscqr-prod-euw2-main/mscqr-backend-servi-euw2",
        "arn:aws:ecs:eu-west-2:368992683803:service-revision/mscqr-prod-euw2-main/mscqr-backend-servi-euw2/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "ListStageBTasksReadOnly",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeStageBTasksReadOnly",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "ecs:cluster": "arn:aws:ecs:eu-west-2:368992683803:cluster/mscqr-prod-euw2-main"
        }
      }
    },
    {
      "Sid": "DescribeStageBTaskDefinitionsReadOnly",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ListStageBTaskDefinitionsReadOnly",
      "Effect": "Allow",
      "Action": "ecs:ListTaskDefinitions",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ReadStageBBrokerConfiguration",
      "Effect": "Allow",
      "Action": "lambda:GetFunctionConfiguration",
      "Resource": [
        "arn:aws:lambda:eu-west-2:368992683803:function:mscqr-production-rls-approval-broker",
        "arn:aws:lambda:eu-west-2:368992683803:function:mscqr-production-rls-approval-broker:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "ReadStageBBrokerReviewedAlias",
      "Effect": "Allow",
      "Action": "lambda:GetAlias",
      "Resource": "arn:aws:lambda:eu-west-2:368992683803:function:mscqr-production-rls-approval-broker:reviewed",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "VerifyExactStageBPermissionReportSignature",
      "Effect": "Allow",
      "Action": "kms:Verify",
      "Resource": "arn:aws:kms:eu-west-2:368992683803:key/437cdebd-95e7-4aba-8f0f-2ca08edb0478"
    }
  ]
}
