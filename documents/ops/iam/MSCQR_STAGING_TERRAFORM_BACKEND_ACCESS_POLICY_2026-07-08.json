{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStagingTerraformStatePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mscqr-staging-terraform-state-368992683803",
      "Condition": {
        "StringLike": {
          "s3:prefix": "staging-api/terraform.tfstate*"
        }
      }
    },
    {
      "Sid": "ReadWriteStagingTerraformStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mscqr-staging-terraform-state-368992683803/staging-api/terraform.tfstate"
    },
    {
      "Sid": "ReadWriteDeleteStagingTerraformStateLockfile",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::mscqr-staging-terraform-state-368992683803/staging-api/terraform.tfstate.tflock"
    }
  ]
}
