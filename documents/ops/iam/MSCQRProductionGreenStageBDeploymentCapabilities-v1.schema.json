{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mscqr.com/schemas/production-green-stage-b-deployment-capabilities-v1.json",
  "title": "MSCQR production green Stage B deployment capability graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deployment", "account", "region", "phases", "identities", "capabilities", "directProbes", "sourceScan", "artifactContracts", "stateContracts", "freshnessContracts", "configurationContracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deployment": { "const": "production-green-stage-b" },
    "account": { "const": "368992683803" },
    "region": { "const": "eu-west-2" },
    "phases": { "type": "array", "minItems": 31, "maxItems": 31, "items": { "$ref": "#/$defs/phase" } },
    "identities": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
    "directProbes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "action"], "properties": { "id": { "type": "string" }, "action": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z*]+$" } } } },
    "sourceScan": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sourceFile", "action"], "properties": { "sourceFile": { "type": "string" }, "action": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z*]+$" } } } },
    "artifactContracts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "stateContracts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "freshnessContracts": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "configurationContracts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "sourceFile"],
      "properties": { "order": { "type": "integer", "minimum": 1 }, "id": { "type": "string" }, "sourceFile": { "type": "string" } }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "identity", "executor", "sourceFile", "sourceFunction", "action", "resources", "context", "classification", "probe", "policy", "required", "mutation"],
      "properties": {
        "id": { "type": "string" }, "phase": { "type": "string" }, "identity": { "type": "string" }, "executor": { "type": "string" },
        "sourceFile": { "type": "string" }, "sourceFunction": { "type": "string" }, "action": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z*]+$" },
        "resources": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "context": {},
        "classification": { "enum": ["ADMIN_DIRECT_READ", "ADMIN_SIMULATION", "ADMIN_SIGN", "BOOTSTRAP_SESSION", "RELEASE_DIRECT_READ", "TERRAFORM_REFRESH_READ", "TERRAFORM_PLAN_READ", "TERRAFORM_APPLY_MUTATION", "POST_APPLY_READ", "GITHUB_IMAGE_MUTATION", "SERVICE_RUNTIME_ACTION", "FORBIDDEN"] },
        "probe": { "enum": ["direct", "administrator-simulation", "plan-derived-simulation", "structural"] },
        "probeIds": { "type": "array", "items": { "type": "string" } }, "policy": { "type": "object" }, "required": { "type": "boolean" }, "mutation": { "type": "boolean" }
      }
    }
  }
}
