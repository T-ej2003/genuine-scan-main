{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegisterExactStageBBackendTaskDefinition1024",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-rls-green-backend-candidate:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b",
          "aws:RequestTag/MSCQRExecTarget": "production-backend",
          "ecs:privileged": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Component",
            "Environment",
            "ManagedBy",
            "MSCQRExecTarget"
          ],
          "ecs:compute-compatibility": [
            "FARGATE"
          ]
        },
        "NumericEquals": {
          "ecs:task-cpu": 1024,
          "ecs:task-memory": 2048
        },
        "Null": {
          "ecs:compute-compatibility": "false"
        }
      }
    },
    {
      "Sid": "RegisterExactStageBTaskDefinitions1024",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": [
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-application-canary:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-admin-bootstrap:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-admin-ownership:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-capability-preflight:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-role-provision:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-role-verify:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-rollback:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-runtime-policy:*",
        "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-full-rls-green-full-rls-verification:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b",
          "ecs:privileged": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Component",
            "Environment",
            "ManagedBy"
          ],
          "ecs:compute-compatibility": [
            "FARGATE"
          ]
        },
        "NumericEquals": {
          "ecs:task-cpu": 1024,
          "ecs:task-memory": 2048
        },
        "Null": {
          "ecs:compute-compatibility": "false"
        }
      }
    },
    {
      "Sid": "RegisterExactStageBTaskDefinitionWorker",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-rls-green-worker-candidate:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b",
          "ecs:privileged": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Component",
            "Environment",
            "ManagedBy"
          ],
          "ecs:compute-compatibility": [
            "FARGATE"
          ]
        },
        "NumericEquals": {
          "ecs:task-cpu": 512,
          "ecs:task-memory": 1024
        },
        "Null": {
          "ecs:compute-compatibility": "false"
        }
      }
    },
    {
      "Sid": "RegisterExactPreDeploymentInventoryTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:eu-west-2:368992683803:task-definition/mscqr-production-rls-green-predeployment-inventory:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2",
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "full-rls-green-stage-b",
          "aws:RequestTag/MSCQRPreDeploymentInventory": "rotation-inventory",
          "ecs:privileged": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Component", "Environment", "ManagedBy", "MSCQRPreDeploymentInventory"],
          "ecs:compute-compatibility": ["FARGATE"]
        },
        "NumericEquals": { "ecs:task-cpu": 256, "ecs:task-memory": 512 },
        "Null": { "ecs:compute-compatibility": "false" }
      }
    },
    {
      "Sid": "DescribeOnlyExactStageBTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    },
    {
      "Sid": "PassOnlyExactStageBTaskRolesToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-executor-task",
        "arn:aws:iam::368992683803:role/mscqr-production-full-rls-green-executor-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-backend-task",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-backend-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-worker-task",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-worker-execution",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-canary-task",
        "arn:aws:iam::368992683803:role/mscqr-production-rls-green-canary-execution"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
