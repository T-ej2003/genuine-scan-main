{
  "schemaVersion": 1,
  "environment": "production",
  "status": "implemented-requires-protected-environment-approval",
  "deploymentModel": "blue-green-clean-room",
  "database": "mscqr_production_rls_green_phase2",
  "maintenanceDatabase": "mscqr_production",
  "databaseAdministrator": "mscqr_prod_admin",
  "administrativeSecret": "mscqr/production/rls-green/phase2/database-url/admin",
  "runtimeSecretPrefix": "mscqr/production/rls-green/phase2/database-url/",
  "rolePrefix": "mscqr_prd_rls_phase2_",
  "deploymentId": "phase2",
  "tlsRequired": true,
  "targetMustBeFresh": true,
  "managedRolesMustBeNew": true,
  "noRequiredCustomerDataPrecondition": true,
  "packageRoot": "/app/scripts/rls/sql/generated",
  "evidenceRoot": "/app/documents/security/rls-program/generated",
  "receiptPrefix": "rls-receipts/",
  "activationOrder": [
    "full-rls-capability-preflight",
    "full-rls-admin-bootstrap",
    "full-rls-role-provision",
    "full-rls-role-verify",
    "full-rls-admin-ownership",
    "full-rls-runtime-policy",
    "full-rls-verification"
  ],
  "modes": {
    "full-rls-capability-preflight": {
      "mutating": false,
      "packageFile": null
    },
    "full-rls-role-provision": {
      "mutating": true,
      "confirmation": "MSCQR_PRODUCTION_GREEN_PROVISION_RUNTIME_ROLES",
      "packageFile": null
    },
    "full-rls-role-verify": {
      "mutating": false,
      "packageFile": null
    },
    "full-rls-admin-bootstrap": {
      "mutating": true,
      "confirmation": "MSCQR_PRODUCTION_GREEN_CREATE_AND_BOOTSTRAP_DATABASE",
      "packageFile": "admin-bootstrap.sql"
    },
    "full-rls-admin-ownership": {
      "mutating": true,
      "confirmation": "MSCQR_PRODUCTION_GREEN_INSTALL_OWNERSHIP_GRANTS",
      "packageFile": "admin-ownership.sql",
      "schemaMigration": "prisma migrate deploy",
      "migrationCredential": "mscqr/production/rls-green/phase2/database-url/migration"
    },
    "full-rls-runtime-policy": {
      "mutating": true,
      "confirmation": "MSCQR_PRODUCTION_GREEN_INSTALL_RUNTIME_POLICIES",
      "packageFile": "runtime-policy.sql"
    },
    "full-rls-verification": {
      "mutating": false,
      "packageFile": "verification.sql"
    },
    "full-rls-rollback": {
      "mutating": true,
      "confirmation": "MSCQR_PRODUCTION_GREEN_ROLLBACK_EXACT_PACKAGE",
      "packageFile": "clean-room-cleanup.sql"
    }
  },
  "task": {
    "familyPrefix": "mscqr-production-full-rls-green-",
    "containerName": "full-rls-green",
    "command": [
      "node",
      "scripts/production-full-rls-green-executor.mjs"
    ],
    "directDatabaseCredentialsInWorkflow": false,
    "callerOverridesAllowed": false,
    "publicNetworkingAllowed": false,
    "readonlyRootFilesystem": true,
    "linuxCapabilities": []
  },
  "releaseBinding": [
    "releaseSha",
    "sourceContractSha256",
    "packageChecksumSha256",
    "executorImageDigest",
    "backendImageDigest",
    "workerImageDigest",
    "frontendImageDigest"
  ],
  "rollback": {
    "automaticBeforeTraffic": true,
    "requiresNoAcceptedGreenWrites": true,
    "restoresFreshCatalogue": true,
    "receiptRequired": true
  }
}
