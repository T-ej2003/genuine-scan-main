  "releaseBinding": [
    "environment",
    "releaseSha",
    "deploymentId",
    "greenDatabase",
    "sourceContractSha256",
    "migrationSetDigest",
    "packageChecksumSha256",
    "administratorIdentity",
    "approvalId",
    "ticketId",
    "independentCheckerIdentity",
    "approvalExpiry",
    "executorImageDigest",
    "backendImageDigest"
