    "rollback": {
      "mode": "full-rls-rollback",
      "automaticBeforeTraffic": true,
      "requiresGreenConsumersStopped": true,
      "requiresNoAcceptedGreenWrites": true,
      "dropsOnlyExactPackageMarkedRoles": true,
      "receiptRequired": true
